rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return request.auth.token;
    }
    function hasRole(role) {
      return signedIn() && profile().role == role;
    }
    function linkedStudent(studentId) {
      return hasRole('parent') && studentId in profile().linkedStudents;
    }

    match /students/{studentId} {
      allow read: if (hasRole('student') && request.auth.uid == studentId)
        || (hasRole('parent') && linkedStudent(studentId));
      allow update: if hasRole('student') && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastSeenAt']);
      allow create, delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if hasRole('teacher') && request.auth.uid == teacherId;
      allow update: if hasRole('teacher') && request.auth.uid == teacherId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastSeenAt']);
      allow create, delete: if false;
    }

    match /parents/{parentId} {
      allow read: if hasRole('parent') && request.auth.uid == parentId;
      allow update: if hasRole('parent') && request.auth.uid == parentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastSeenAt']);
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow read: if hasRole('teacher')
        || (hasRole('student') && resource.data.studentId == request.auth.uid)
        || linkedStudent(resource.data.studentId);
      allow write: if false;
    }

    match /grades/{gradeId} {
      allow read: if hasRole('teacher')
        || (hasRole('student') && resource.data.studentId == request.auth.uid)
        || linkedStudent(resource.data.studentId);
      allow write: if false;
    }

    match /fees/{feeId} {
      allow read: if linkedStudent(resource.data.studentId);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.parentId == request.auth.uid;
      allow write: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if hasRole('admin');
    }
  }
}